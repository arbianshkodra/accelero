# =============================================================================
# Accelero Configuration — daemon-level settings.
#
# Usage:
#   cp .env.example .env    # then fill in the values below
#   docker run --env-file .env ...   # or source before running the binary
#
# Note: this file configures the Accelero daemon itself.  It is NOT the
# same as the `.env` that lives inside your GitOps repo next to
# docker-compose.yaml — that one feeds ${VAR} interpolation for your
# compose.  See samples/.env for an example of the GitOps-side .env.
# =============================================================================

# REQUIRED: API key for webhook/API authentication
API_KEY=your_secure_api_key_here

# Server port (default: 8000)
# SERVER_PORT=8000

# Docker socket path (default: unix:///var/run/docker.sock)
# DOCKER_SOCK=unix:///var/run/docker.sock

# Database path (default: ./data/accelero.db)
# DATABASE_PATH=./data/accelero.db

# Logging
# LOG_LEVEL=info          # debug, info, warn, error
# LOG_FORMAT=text         # text or json

# Performance tuning (optional)
# WORKER_COUNT=10         # Override automatic CPU-based worker calculation
# QUEUE_SIZE=150          # Override automatic queue size calculation

# Cleanup intervals (optional)
# STATUS_CLEANUP_INTERVAL=1h    # How often to clean up old deployment records
# STATUS_MAX_AGE=24h            # Max age before deployment record cleanup

# Scheduled local DB backups (optional). Disabled unless BACKUP_INTERVAL is set.
# Writes a consistent snapshot on startup and every interval into BACKUP_DIR,
# keeping only the newest BACKUP_KEEP. Same snapshot as POST /admin/backup.
# BACKUP_INTERVAL=24h
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=7

# Per-API-key rate limiting (applied after authentication).
# RATE_LIMIT_RPS=0 disables it; any positive value enables the limiter.
# RATE_LIMIT_BURST defaults to max(2*RPS, 10) when only RPS is set.
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20

# Retries for transient deploy-path operations (image pulls, git clones,
# network creation), with exponential backoff + jitter. Auth/not-found
# failures fail fast and are never retried. RETRY_MAX_ATTEMPTS=1 disables
# retrying. Delays are Go durations.
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=1s
# RETRY_MAX_DELAY=30s

# Auto-deploy circuit breaker. A stack that fails this many reconcile
# deploys in a row trips open: the reconciler stops auto-deploying it
# until the cooldown elapses, then allows one trial (self-heals when the
# repo is fixed). Manual deploys are never gated. THRESHOLD=0 disables.
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_COOLDOWN=10m

# Native TLS. Both must be set together (only one set is a fatal error).
# Most setups terminate TLS at a reverse proxy and leave this unset.
# TLS_CERT_FILE=/etc/accelero/cert.pem
# TLS_KEY_FILE=/etc/accelero/key.pem
#
# HSTS max-age in seconds (default 31536000 = 1 year). 0 disables. Only
# emitted when TLS is on. Accelero never sets includeSubDomains/preload;
# configure those at the edge.
# TLS_HSTS_MAX_AGE=31536000

# Content-Security-Policy header value. Default is locked down since
# Accelero serves no browser UI. Set to an explicit empty string to omit
# the header (e.g. behind an edge proxy that sets its own). The companion
# headers (X-Content-Type-Options, X-Frame-Options, Referrer-Policy) are
# always sent regardless.
# CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'

# HMAC-SHA256 signing for the legacy POST /webhook endpoint.
# When set, external callers (GitHub, Gitea, CI) sign the raw request
# body and pass the hex digest as X-Hub-Signature-256: sha256=<hex>,
# replacing the API-key check on /webhook. /api/v1/webhook still
# requires the API key.
# WEBHOOK_SECRET=

# At-rest encryption for sensitive stack fields (repo_token, docker_password).
# Base64-encoded 32 bytes.  Generate with:  openssl rand -base64 32
# Unset = plaintext (fine for local dev, warned at startup).
# Migrate existing plaintext rows with:  POST /api/v1/admin/encrypt-existing
#
# Two sources are supported. Pick one — setting both is a fatal error.
#   1. Inline env var (simple, fine for local dev):
# ACCELERO_ENCRYPTION_KEY=
#   2. File path (preferred in production — env vars leak through
#      `docker inspect`, `ps`, systemd unit files; files mounted as
#      Docker/K8s secrets don't). Trailing newlines are trimmed.
# ACCELERO_ENCRYPTION_KEY_FILE=/run/secrets/accelero-encryption-key

# =============================================================================
# Legacy single-stack mode (backward compatible)
# If these are set, a "default" stack is auto-created on first startup.
# For multi-stack setups, use the API instead.
# =============================================================================
# REPO_URL=https://your-repo-url.com
# REPO_USERNAME=your-username
# REPO_TOKEN=your-token
# REPO_BRANCH=main
# COMPOSE_PATH=docker-compose.yaml
# SERVICE_NAMES=                    # comma-separated, empty = all services

# Docker registry credentials (per-stack via API, or global via env)
# DOCKER_USERNAME=your-username
# DOCKER_PASSWORD=your-password
# DOCKER_REGISTRY=your-registry
