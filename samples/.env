# Sample .env for the GitOps repo compose.  Rename to `.env` and commit it
# alongside docker-compose.yaml in your GitOps repo.  Accelero reads it and
# substitutes ${VAR} references in the compose file before parsing.
#
# Do NOT confuse this with sample.env / samples/samples.env — those
# configure the Accelero daemon itself (API_KEY, server port, etc.).  This
# file belongs in *your* GitOps repo next to your compose.
#
# Supported syntax (from docs/usage-overview.md):
#   KEY=value
#   QUOTED="with \n escapes"
#   LITERAL='literal, no escapes'
#   export EXPORTED=works_too
#   # comments start with #

# --- Used by samples/docker-compose.yaml ---

# Image override; if unset, compose falls back to its :- default.
# NGINX_TAG=nginx:1.27.1

# Caddy tag — required (compose uses :? to fail fast if missing).
CADDY_TAG=2-alpine

# Optional port/target overrides with defaults in the compose.
# WEB_PORT=80
# PUBLIC_PORT=80
