# =============================================================================
# samples.env — sample environment for the Accelero DAEMON itself.
#
# This file is for configuring Accelero when you run it.  It is *not* the
# same as the `.env` next to this file — that one belongs to the GitOps
# repo's compose and feeds ${VAR} interpolation.
#
# Rename to `.env` on the host where you run Accelero, or pass via
# `docker run --env-file`.
# =============================================================================

# Required
API_KEY=

# Optional server settings
# SERVER_PORT=8000
# DOCKER_SOCK=unix:///var/run/docker.sock
# DATABASE_PATH=./data/accelero.db

# Legacy single-stack mode (creates a "default" stack on first startup).
# Prefer the REST API for multi-stack setups.
REPO_URL=
REPO_USERNAME=
REPO_TOKEN=
REPO_BRANCH=
COMPOSE_PATH=
SERVICE_NAMES=

# Docker registry (optional)
DOCKER_USERNAME=
DOCKER_PASSWORD=
DOCKER_REGISTRY=
