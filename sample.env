REPO_URL=https://your-repo-url.com
REPO_USERNAME=your-username
REPO_TOKEN=your-token
REPO_BRANCH=your-branch
COMPOSE_PATH=your-compose-path
SERVICE_NAMES=

# docker
DOCKER_SOCK=unix:///var/run/docker.sock
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password
DOCKER_REGISTRY=your-registry

API_KEY=your_secure_api_key_here

# Performance tuning (optional)
# WORKER_COUNT=10  # Override automatic CPU-based worker calculation
# QUEUE_SIZE=150   # Override automatic queue size calculation

# Memory management (optional)
# STATUS_CLEANUP_INTERVAL=30m   # How often to clean up old statuses (default: 1h)
# STATUS_MAX_AGE=12h            # Max age before status cleanup (default: 24h)